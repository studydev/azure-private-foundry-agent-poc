        <mxCell id="lgTitle" value="Verification flow" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#12263F;" vertex="1" parent="1">
          <mxGeometry x="84" y="738" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lgBody" value="1&#160;&#160;Runner starts the Job through ARM (public)&#10;2&#160;&#160;Job executes INSIDE snet-aca&#10;3&#160;&#160;Job calls the backend on its internal FQDN&#10;4&#160;&#160;Backend calls the Foundry Agent via private endpoint&#10;5&#160;&#160;Agent reads/writes its BYO stores, all private&#10;6&#160;&#160;Exit code + console log stream give the verdict&#10;&#10;Negative control: the same probes run from the&#10;public runner and MUST fail. That failure is the&#10;evidence the isolation is real." style="text;html=1;fontSize=13;align=left;verticalAlign=top;fontColor=#12263F;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="84" y="768" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lgKey" value="&#9473;&#9473; control plane (public) &#160;&#160;&#9473;&#9473; private data path &#160;&#160;&#9473;&#9473; DNS / PE &#160;&#160;&#9473;&#9473; injected runtime" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#5A6B7D;" vertex="1" parent="1">
          <mxGeometry x="84" y="1000" width="400" height="34" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="VERIFIED: from inside the VNet the Foundry endpoint resolves to 10.0.8.6 and the agent round trip returns PRIVATE_AGENT_PASS. From the public internet the app FQDN does not resolve and the Foundry data plane returns HTTP 403 even with a valid token." style="text;html=1;fontSize=14;align=left;verticalAlign=middle;fontColor=#5A6B7D;" vertex="1" parent="1">
          <mxGeometry x="60" y="1340" width="1600" height="26" as="geometry" />
